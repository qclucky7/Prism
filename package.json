{
  "name": "browser-fingerprint-analyzer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:engine": "node scripts/build-engine.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "predev": "npm run build",
    "prestart": "npm run build && node scripts/native.mjs build",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:engine && tsc --noEmit && vite build",
    "start": "node scripts/native.mjs serve",
    "desktop:dev": "npm run build && node scripts/native.mjs build && node scripts/native.mjs desktop",
    "desktop:build": "tauri build",
    "test": "node scripts/test.mjs",
    "test:e2e": "tsx tests/smoke.ts",
    "native:build": "npm run build && node scripts/native.mjs build",
    "pretest": "npm run build",
    "pretest:e2e": "npm run build && node scripts/native.mjs build"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.7.0",
    "dayjs": "^1.11.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@fingerprintjs/fingerprintjs": "5.3.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-typescript": "^12.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.0",
    "rollup": "^4.68.2",
    "tslib": "^2.9.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qclucky7/Prism.git"
  },
  "bugs": {
    "url": "https://github.com/qclucky7/Prism/issues"
  },
  "homepage": "https://github.com/qclucky7/Prism#readme"
}
